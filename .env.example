# ==============================================================================
# SIMAP PLATFORM - FRONTEND CONFIGURATION (.env)
# ==============================================================================

# Core Backend (Microservicio 1 - FastAPI en puerto 8000)
VITE_API_URL=http://localhost:8000

# Chatbot Auditor Microservice (Microservicio 5 - Chatbot SSE / Iframe en puerto 8501)
VITE_CHATBOT_URL=http://localhost:8501

# ------------------------------------------------------------------------------
# NOTA DE ARQUITECTURA (GOOGLE GEMINI & OLLAMA):
# - No se requieren claves de OpenAI ni variables tipo VITE_OPENAI_API_KEY.
# - Las credenciales de Google Gemini (GEMINI_API_KEY) están protegidas en el backend.
# - El motor predeterminado es Google Gemini (gemini-3.1-flash-lite) con respaldo Ollama.
# ------------------------------------------------------------------------------
